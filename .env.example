# Copy to .env and fill in. Never commit the real .env.
BRAVE_API_KEY=your-bra...here

# Optional: Brave Answers is a separate product with its own key.
# The Answers tab hides automatically when this is unset.
BRAVE_ANSWERS_KEY=

# Optional: Bright Data SERP API unlocks Google/Bing web engines (Google also
# supports News). Both variables are required; the engine pills hide
# automatically when unset. Zone name is from your Bright Data control panel.
BRIGHTDATA_SERP_API_KEY=
BRIGHTDATA_SERP_ZONE=

# Optional: a second Answers backend speaking the OpenAI chat-completions
# protocol (vLLM, Ollama, llama.cpp server, or a hosted endpoint). The Answers
# tab then shows Brave/<label> pills. Model auto-detects from GET <base>/models
# unless LOCAL_CHAT_MODEL is pinned. WARNING: an http:// base URL sends your
# questions in plaintext over the network (see README "Security notes").
# Optional: SerpApi (https://serpapi.com) - serves the Google pill with
# places coordinates (map pins!) and wins over BrightData when both exist.
SERPAPI_KEY=

# Optional: SearchApi.io (https://www.searchapi.io) - commercial SERP vendor
# (NOT privacy-related despite the DuckDuckGo results it can serve; zero
# retention is enterprise-tier only). Enables the DuckDuckGo engine (web/
# images) and adds Google/Bing coverage. Free tier ~100 searches/month:
# pair with provider_quotas in config.json.
SEARCHAPI_KEY=

# Optional: self-hosted SearXNG metasearch (web/news/images). The instance
# must allow the JSON API: search.formats: [json] in its settings.yml.
SEARXNG_URL=

LOCAL_CHAT_BASE_URL=
LOCAL_CHAT_API_KEY=
LOCAL_CHAT_MODEL=
LOCAL_CHAT_LABEL=Local

PORT=5000
# Bind address. Default 127.0.0.1 (local only). Use 0.0.0.0 to expose on a private network.
HOST=127.0.0.1
